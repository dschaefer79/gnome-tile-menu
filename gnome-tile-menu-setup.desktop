[Desktop Entry]
Version=1.0
Type=Application
Name=Window Tiling menu setup
Comment=Turn on the Window Tiling and Resolution menus once per user
Exec=gnome-tile-menu setup --auto
Terminal=false
NoDisplay=true
OnlyShowIn=GNOME;
